# ==============================================================================
# AFTERHOURS ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and provide your production credentials
# ==============================================================================

# --- SUPABASE CONFIGURATION ---
# Connect to your Supabase project (https://supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- TELEGRAM BOT & MTPROTO CREDENTIALS ---
# Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
# Telegram API ID and Hash from https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# Target Private Channel for Afterhours Music Vault (typically a negative 64-bit int e.g. -100xxxxxxxxxx)
TELEGRAM_VAULT_CHAT_ID=-1001234567890

# --- AUTHENTICATION SECRET ---
# Cryptographically secure random secret (min 32 characters) used to derive user credentials & sign app JWTs
AUTH_SECRET=generate-a-secure-random-32-byte-hex-secret-here

# --- STORAGE & CACHING ---
AUDIO_CACHE_DIR=./cache/audio
ARTWORK_CACHE_DIR=./cache/artwork
MAX_CACHE_SIZE_MB=5000
MAX_UPLOAD_SIZE_MB=100

# --- AUDIO STREAMING ---
MAX_CONCURRENT_STREAMS=20
TRANSCODING_BITRATE=256k

# --- ENVIRONMENT ---
ENVIRONMENT=production

# --- FRONTEND (NEXT.JS) ---
NEXT_PUBLIC_API_URL=https://afterhours.yourdomain.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
